# ==============================================================================
# Sabores del Llano — Configuración de entorno del Backend (Ejemplo)
# ==============================================================================
# Copia este archivo como `.env` dentro de la carpeta `backend/` y reemplaza
# los valores de ejemplo por las credenciales reales de tu entorno local.
# IMPORTANTE: Nunca subas el archivo `.env` real al control de versiones.
#
# Parámetros de conexión a MySQL:
# - Driver requerido: mysql+pymysql
# - Usuario: usuario de MySQL (ej. root o usuario dedicado)
# - Contraseña: contraseña de MySQL (si tiene caracteres especiales como @, :, /,
#   deben codificarse en formato URL, por ejemplo %40)
# - Host: dirección del servidor MySQL (ej. localhost o 127.0.0.1)
# - Puerto: puerto de MySQL (por defecto 3306)
# - Base de datos: sabores_del_llano
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@localhost:3306/sabores_del_llano

# Orígenes permitidos para CORS (separados por comas, sin barra final ni comodines *)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Entorno de ejecución de la aplicación (development, testing, production)
APP_ENV=development

# Configuración de Autenticación (JWT HMAC-SHA256)
# Genera una clave aleatoria de al menos 32 caracteres (ej: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=REEMPLAZAR_POR_CLAVE_SECRETA_ALEATORIA_DE_MINIMO_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Inicialización del primer usuario administrador (tabla `usuarios`)
# Configura estas variables en tu archivo local `backend/.env` antes de ejecutar:
# .\backend\.venv\Scripts\python.exe backend/app/services/auth.py --init-admin
ADMIN_INITIAL_USERNAME=REEMPLAZAR_POR_USUARIO_ADMIN
ADMIN_INITIAL_FULL_NAME=Doña Martha - Administración
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA_DE_MINIMO_8_CARACTERES
