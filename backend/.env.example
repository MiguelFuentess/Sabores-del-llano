# ==============================================================================
# Sabores del Llano — Configuración de entorno del Backend (Ejemplo)
# ==============================================================================
# Copia este archivo como `.env` dentro de la carpeta `backend/` y reemplaza
# los marcadores por las credenciales reales de tu entorno.
# IMPORTANTE: Nunca subas el archivo `.env` real al control de versiones.
#
# 1) Conexión a Base de Datos (MySQL 8 local o TiDB Cloud Serverless):
# - Driver requerido: mysql+pymysql
# - Desarrollo local (sin TLS por defecto):
#   DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@localhost:3306/sabores_del_llano?charset=utf8mb4
# - Producción en TiDB Cloud Serverless (puerto 4000, TLS 1.2+ verificado con certifi):
#   DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/sabores_del_llano?charset=utf8mb4
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@localhost:3306/sabores_del_llano?charset=utf8mb4

# Opciones TLS para MySQL / TiDB Cloud:
# - Si se deja vacío, TLS se activa automáticamente cuando el host es remoto
#   (ej. *.tidbcloud.com) y permanece desactivado para localhost / 127.0.0.1.
# - Define DB_SSL_REQUIRED=true para forzar TLS verificado o false para desactivarlo.
# - Define DB_SSL_CA=/ruta/al/ca.pem solo si requieres una CA distinta a `certifi`.
DB_SSL_REQUIRED=
DB_SSL_CA=

# 2) Orígenes permitidos para CORS (separados por comas, sin barra final ni comodines *):
# - En APP_ENV=production es obligatorio definir orígenes explícitos con esquema https://
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 3) Entorno de ejecución (development, testing, production):
# - En APP_ENV=production el arranque falla inmediatamente (fail-fast) si faltan
#   DATABASE_URL, AUTH_SECRET_KEY o FRONTEND_ORIGINS, si alguno usa valores de
#   plantilla (REEMPLAZAR_*, CHANGEME, USUARIO:CONTRASENA) o si FRONTEND_ORIGINS no usa https://.
APP_ENV=development

# 4) Configuración de Autenticación (JWT HMAC-SHA256):
# Genera una clave criptográfica aleatoria de mínimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=REEMPLAZAR_CLAVE_SECRETA_JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 5) Inicialización idempotente del primer usuario administrador (tabla `usuarios`):
#   python -m app.services.auth --init-admin
ADMIN_INITIAL_USERNAME=REEMPLAZAR_USUARIO_ADMIN
ADMIN_INITIAL_FULL_NAME=Doña Luz - Administración
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CONTRASENA_ADMIN
